{
  "name": "general-knowledge-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:poll": "tsx scripts/dev-poll.ts",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply general-knowledge --local",
    "db:migrate:remote": "wrangler d1 migrations apply general-knowledge --remote",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "import": "tsx scripts/import-jsonl.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "grammy": "^1.31.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.10",
    "@types/node": "^22.20.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.32.0"
  }
}
