      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BOT_INFO": "{\"id\":8835770256,\"is_bot\":true,\"first_name\":\"General Knowledge\",\"username\":\"GenowledgeBot\",\"can_join_groups\":true,\"can_read_all_group_messages\":false,\"supports_inline_queries\":false}"
  }
