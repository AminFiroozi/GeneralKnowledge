{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "general-knowledge-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
