{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "general-knowledge-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "general-knowledge",
      "database_id": "REPLACE_WITH_WRANGLER_D1_CREATE_OUTPUT",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BOT_INFO": "{\"id\":0,\"is_bot\":true,\"first_name\":\"REPLACE\",\"username\":\"REPLACE_bot\",\"can_join_groups\":true,\"can_read_all_group_messages\":false,\"supports_inline_queries\":false}"
  }
}
